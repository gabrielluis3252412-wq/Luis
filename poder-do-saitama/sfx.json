,[63.416,"zoom",0.8],[63.766,"M_silence",1],[63.766,"slowmo",0.6],[63.816,"heart",0.9],[64.258,"whiff",1.2],[64.418,"M_hit",1],[64.418,"punch",1.5],[64.418,"boom",1.6],[64.418,"clash",1.1],[64.468,"thunder",0.8],[64.518,"kaiju_hurt",0.9],[64.618,"glass",0.5],[65.126,"whoosh",0.8],[65.326,"wind_blast",1.2],[65.669,"warp",0.7],[67.388,"shimmer",0.9],[67.973,"flash",0.6],[68.073,"ping",0.8],[68.173,"M_ko",1],[68.173,"amb_wind",0.5],[69.176,"stamp",1.1],[69.176,"hit",0.6],[69.376,"cheer",0.9],[69.897,"tick",0.6],[70.008,"tick",0.6],[70.119,"tick",0.6],[70.247,"ding",0.6],[70.422,"babble",0.9],[70.422,"pop",0.45],[70.492,"dark",0.8],[70.792,"M_lonely",1],[70.792,"amb_night",0.9],[73.195,"tick",0.4],[75.115,"sting_low",0.8],[75.712,"dark",0.8],[76.012,"wind",1],[76.012,"amb_night",0.6],[80.197,"beep",0.4],[80.713,"whoosh",0.8],[80.913,"amb_room",0.8],[81.869,"yawn",0.9],[83.497,"snore",0.6],[83.916,"dark",0.8],[84.216,"amb_wind",0.6],[84.695,"beep",0.55],[85.848,"beep",0.55],[86.284,"sting_hi",0.5],[86.876,"M_heart",1],[86.876,"heart",0.9],[86.876,"riser_s",0.7],[86.896,"beep",0.4],[87.52,"babble",0.9],[87.52,"pop",0.45],[87.64,"flash",0.6],[87.776,"heart",0.9],[87.796,"beep",0.4],[87.84,"M_cta",1],[87.84,"flash",0.8],[87.99,"whoosh",0.8],[88.04,"hit",0.8],[88.06,"pop",0.8],[88.739,"punch",0.35],[88.739,"click",0.6],[88.829,"punch",0.35],[88.829,"click",0.6],[88.919,"punch",0.35],[88.919,"click",0.6],[89.009,"punch",0.35],[89.009,"click",0.6],[89.099,"punch",0.35],[89.099,"click",0.6],[89.189,"punch",0.35],[89.189,"click",0.6],[89.189,"boom",0.8],[89.87,"click",1],[89.92,"send",1],[89.97,"sparkle",0.7],[90.522,"ping",1.2],[91.188,"whoosh",0.7],[91.788,"final",0.9],[92.333,"M_end",1]],"total":92.33333333333333,"phrases":[["E se você tivesse o mesmo poder absurdo de Saitama, capaz de derrotar qualquer inimigo com apenas um soco?",1.6,7.546],["Tudo começaria quando você decidisse treinar até ultrapassar os limites humanos.",8.096,12.501000000000001],["Durante três anos, você faria cem flexões, cem abdominais, cem agachamentos e correria dez quilômetros todos os dias.",12.951,20.192],["No início, seu corpo sofreria com o esforço…",20.692,23.352],["Mas você continuaria, mesmo quando todos dissessem que era impossível.",23.802,27.529],["Até que, depois de milhares de repetições, algo inacreditável aconteceria.",28.029,32.504],["Seus músculos ficariam extremamente resistentes, sua velocidade aumentaria e, de repente, seus cabelos começariam a cair…",32.954,40.013],["Até você ficar completamente careca!",40.363,42.547999999999995],["Mas essa seria a menor das suas preocupações.",43.147999999999996,45.836],["Porque agora, você conseguiria saltar por cima de prédios, correr em velocidades absurdas e enfrentar monstros gigantescos sem sentir medo.",46.236,54.41],["Um inimigo colossal surgiria no meio da cidade.",54.959999999999994,57.461999999999996],["Ele levantaria o punho para destruir tudo…",57.861999999999995,60.102],["Mas você desviaria do golpe, apareceria atrás dele e acertaria um soco tão poderoso que o vento abriria caminho entre as nuvens.",60.501999999999995,67.823],["O monstro seria derrotado em segundos.",68.37299999999999,70.392],["Só que, depois de vencer todas as batalhas, você perceberia algo assustador…",71.042,75.712],["Ser tão poderoso significava nunca mais encontrar um adversário à sua altura.",76.262,80.613],["E talvez o maior desafio não fosse derrotar monstros…",81.163,84.01599999999999],["Mas encontrar algo que ainda fizesse seu coração acelerar.",84.416,87.49],["Comente “CARECA” se você aceitaria esse poder!",88.09,90.988]],"cuts":[0,4.521,6.434,7.846,12.801,14.666000000000002,15.690000000000001,16.737,17.852,19.23,19.3815,19.533,19.6845,19.836,19.9875,20.139,20.2905,20.442,23.602,27.829,32.754,35.538,37.346999999999994,40.213,42.94799999999999,46.035999999999994,49.767,51.653999999999996,54.75999999999999,57.711999999999996,60.382,62.169,63.616,65.326,68.17299999999999,70.792,76.012,80.913,84.216,87.84],"off":1.3}