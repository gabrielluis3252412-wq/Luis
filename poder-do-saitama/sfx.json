53,"M_cta",1],[98.53,"flash",0.8],[98.68,"whoosh",0.8],[98.73,"hit",0.8],[98.73,"pop",0.8],[99.4,"punch",0.35],[99.4,"click",0.6],[99.49,"punch",0.35],[99.49,"click",0.6],[99.58,"punch",0.35],[99.58,"click",0.6],[99.67,"punch",0.35],[99.67,"click",0.6],[99.76,"punch",0.35],[99.76,"click",0.6],[99.85,"punch",0.35],[99.85,"click",0.6],[99.85,"boom",0.8],[100.615,"click",1],[100.665,"send",1],[100.715,"sparkle",0.7],[101.491,"ping",1.2],[101.971,"whoosh",0.7],[102.571,"final",0.9],[103.125,"M_end",1]],"total":103.125,"phrases":[["E se você tivesse o mesmo poder absurdo de Saitama, capaz de derrotar qualquer inimigo com apenas um soco?",1.3,7.913],["Tudo começaria quando você decidisse treinar até ultrapassar os limites humanos.",8.397,13.324],["Durante três anos, você faria cem flexões, cem abdominais, cem agachamentos e correria dez quilômetros todos os dias.",13.744000000000002,22.279],["No início, seu corpo sofreria com o esforço…",22.683,25.337],["Mas você continuaria, mesmo quando todos dissessem que era impossível.",25.743000000000002,30.563000000000002],["Até que, depois de milhares de repetições, algo inacreditável aconteceria.",31.024,36.333],["Seus músculos ficariam extremamente resistentes, sua velocidade aumentaria e, de repente, seus cabelos começariam a cair…",36.757999999999996,44.916],["Até você ficar completamente careca!",45.357,48.269],["Mas essa seria a menor das suas preocupações.",48.704,51.393],["Porque agora, você conseguiria saltar por cima de prédios, correr em velocidades absurdas e enfrentar monstros gigantescos sem sentir medo.",51.754,60.855],["Um inimigo colossal surgiria no meio da cidade.",61.287,64.255],["Ele levantaria o punho para destruir tudo…",64.592,67.093],["Mas você desviaria do golpe, apareceria atrás dele e acertaria um soco tão poderoso que o vento abriria caminho entre as nuvens.",67.44,75.866],["O monstro seria derrotado em segundos.",76.219,78.862],["Só que, depois de vencer todas as batalhas, você perceberia algo assustador…",79.331,84.688],["Ser tão poderoso significava nunca mais encontrar um adversário à sua altura.",85.13,90.357],["E talvez o maior desafio não fosse derrotar monstros…",90.8,94.37899999999999],["Mas encontrar algo que ainda fizesse seu coração acelerar.",94.779,98.29599999999999],["Comente “CARECA” se você aceitaria esse poder!",98.78,101.771]],"cuts":[0,4.67,6.62,8.147,13.594000000000001,15.634000000000002,16.964,18.244,19.483999999999998,21.114,21.278875,21.44375,21.608625,21.7735,21.938375,22.10325,22.268125,22.433,25.543000000000003,30.824,36.55799999999999,39.897999999999996,42.047999999999995,45.207,48.504,51.553999999999995,55.174,57.413999999999994,61.086999999999996,64.442,65.716,67.89,69.4,70.79,71.29,73.16,76.01899999999999,79.081,84.88,90.55,94.579,98.53],"off":1.3}