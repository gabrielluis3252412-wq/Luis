9,"heart",0.85],[59.119,"data",0.47],[59.209,"glitch",0.5],[59.229,"data",0.47],[59.339,"data",0.47],[59.449,"data",0.47],[59.509,"heart",0.85],[59.559,"data",0.47],[59.669,"data",0.47],[59.779,"data",0.47],[59.809,"glitch",0.5],[59.889,"data",0.47],[59.999,"data",0.47],[60.009,"heart",0.85],[60.109,"data",0.47],[60.184,"hit",1],[60.184,"tinnitus",0.6],[60.219,"data",0.47],[60.329,"data",0.47],[60.439,"data",0.47],[60.509,"heart",0.85],[60.549,"data",0.47],[60.627,"whoosh",0.85],[60.659,"data",0.47],[60.769,"data",0.47],[60.827,"amb_night",0.7],[62.143,"cloth",1],[62.493,"M_calm",1],[62.843,"breath",0.6],[65.784,"sonar",0.8],[66.484,"sonar",0.6],[66.822,"dark",0.85],[67.122,"M_rise",1],[67.122,"amb_night",1],[67.122,"wind",0.6],[67.522,"breath",0.5],[69.061,"shimmer",0.5],[71.435,"energy",0.6],[72.528,"flash",0.85],[72.728,"M_final",1],[72.728,"wind",1],[76.181,"swish",0.6],[76.371,"pop",0.5],[77.114,"cloth",0.8],[77.314,"riser_s",0.7],[77.714,"M_pot",1],[77.714,"eye_open",1.1],[77.714,"boom",1.2],[79.248,"shimmer",0.7],[79.875,"dark",0.85],[80.175,"M_end",1],[80.175,"amb_space",1],[82.63,"pop",0.5],[82.666,"riser_s",0.8],[83.166,"M_dsp",1],[83.166,"eye_open",1.2],[83.166,"boom",1.3],[84.319,"final",1]],"total":87.08333333333333,"phrases":[["E se você acordasse amanhã com os Seis Olhos de Satoru Gojo?",0.35,3.499],["No começo, você pensaria que ganhou o poder mais absurdo do universo de Jujutsu Kaisen…",4.049,8.31],["Mas existe um detalhe que pode mudar completamente sua vida.",8.76,11.728],["Primeiro, sua visão mudaria completamente.",12.528,14.581],["Você conseguiria perceber a energia amaldiçoada ao redor das pessoas,",14.981,18.156],["identificar seu fluxo e enxergar detalhes que outros feiticeiros jamais conseguiriam notar.",18.336,22.905],["Imagine entrar em uma sala e perceber que alguém está escondendo uma quantidade gigantesca de energia…",23.355,28.176],["Mesmo sem entender o que está acontecendo, seus olhos já estariam analisando tudo.",28.626,32.173],["Segundo, você descobriria que os Seis Olhos não criam energia infinita.",32.873,36.215],["Eles fazem algo muito mais impressionante:",36.615,38.353],["permitem controlar a energia amaldiçoada com uma precisão extraordinária.",38.603,41.898],["O desperdício se torna praticamente insignificante.",42.298,44.844],["E se você também herdasse a técnica Ilimitada,",45.344,47.465],["poderia manipular o espaço ao seu redor,",47.615,49.517],["criando uma defesa que impede seus inimigos de simplesmente encostarem em você.",49.637,53.162],["Mas então você perceberia o verdadeiro problema…",53.962,56.459],["Seus olhos captariam informações constantemente, causando um enorme desgaste.",56.959,60.527],["É por isso que Gojo utiliza uma venda:",61.027,62.728],["ela ajuda a reduzir o esforço visual, mesmo que ele continue percebendo o ambiente.",62.928,66.822],["Você teria uma das habilidades mais raras do mundo…",67.322,69.687],["Mas precisaria aprender a controlar tudo isso.",70.037,72.278],["Porque possuir os Seis Olhos não significa automaticamente ser o mais forte.",73.028,76.581],["Significa ter o potencial de se tornar alguém extraordinário.",76.981,79.775],["E agora a pergunta é…",80.475,81.547],["Você teria coragem de despertar esse poder?",82.047,84.069]],"cuts":[0,3.8990000000000005,8.56,12.278,14.881,18.235999999999997,23.155,28.426000000000002,32.573,36.465,42.148,45.144,49.487,53.662000000000006,56.809000000000005,60.827,67.122,72.72800000000001,80.175]}