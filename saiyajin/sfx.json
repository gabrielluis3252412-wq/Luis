114.745,"charge",0.7],[114.965,"pop",0.28],[115.185,"pop",0.28],[115.405,"pop",0.28],[115.625,"pop",0.28],[115.845,"pop",0.28],[116.065,"pop",0.28],[116.285,"pop",0.28],[116.505,"pop",0.28],[116.725,"pop",0.28],[116.945,"pop",0.28],[117.025,"riser_s",0.8],[117.165,"pop",0.28],[117.385,"pop",0.28],[117.425,"boom",1.2],[117.425,"unlock",0.9],[117.475,"shimmer",0.8],[117.925,"energy_pulse",0.5],[117.975,"babble",0.9],[117.975,"pop",0.45],[118.425,"heart",0.8],[118.625,"zap",0.4],[118.975,"heart",0.8],[119.175,"zap",0.4],[119.525,"heart",0.8],[119.725,"zap",0.4],[119.835,"M_o_end",1],[119.835,"whoosh",0.7],[120.335,"final",0.9]],"total":121.04166666666667,"phrases":[["E se você fosse um Saiyajin…",0,1.92],["e cada derrota te deixasse mais forte que antes?",1.92,5.42],["Você nasceria em uma das raças guerreiras mais temidas do universo.",6.06,10.12],["Desde pequeno, seria treinado para enfrentar inimigos capazes de destruir planetas inteiros.",10.6,16.36],["Mas seu maior diferencial seria assustador…",16.76,20.3],["Quando sobrevivesse a uma batalha extrema e se recuperasse,",20.9,24.12],["seu corpo poderia aumentar drasticamente o próprio poder.",24.5,27.9],["Isso significa que, quanto mais difícil fosse sua jornada…",27.9,31.88],["maior seria seu potencial de evolução.",32.24,34.62],["Mas tudo mudaria no dia em que enfrentasse um inimigo impossível de derrotar.",35.06,40.02],["Seus amigos estariam em perigo…",40.46,42.24],["E, pela primeira vez, você sentiria uma raiva tão intensa",42.46,46.4],["que seu corpo começaria a liberar uma energia jamais vista.",46.4,50.12],["Seu cabelo ficaria dourado.",50.64,52.34],["Seus olhos mudariam.",52.7,54.02],["E uma aura gigantesca explodiria ao seu redor.",54.02,57.62],["Você teria despertado o lendário Super Saiyajin.",57.62,61.68],["Só que essa transformação seria apenas o começo.",61.88,65.04],["Com treinamento e batalhas cada vez mais difíceis,",65.46,68.68],["você alcançaria poderes capazes de rivalizar com os próprios deuses.",68.86,72.92],["E, no auge da sua evolução, despertaria o Instinto Superior…",73.44,77.76],["Uma habilidade em que seu corpo reagiria sozinho, desviando de ataques quase impossíveis.",78.22,83.7],["Mas existe uma verdade que poucos entendem sobre os Saiyajins…",84.12,87.92],["Eles não são extraordinários porque nunca são derrotados.",88.38,91.6],["Eles são extraordinários porque, mesmo depois de cair,",92.02,95.34],["sempre encontram uma maneira de se tornar mais fortes.",95.68,98.98],["Cibito está prestes a desbloquear um novo poder de animação,",102.825,106.625],["mas, para isso, ele precisa da sua ajuda.",107.125,110.065],["Deixe o like, inscreva-se no canal e mostre sua força.",110.545,114.065],["Cada curtida aproxima Cibito de sua próxima transformação.",114.545,117.945],["Será que ele vai conseguir?",118.425,119.585]],"cuts":[0,5.859999999999999,10.4,13.120000000000001,16.51,20.7,27.7,34.81,40.26,42.31,50.39,52.550000000000004,53.82,57.419999999999995,61.68,65.30999999999999,68.71,73.19,78.02,83.87,88.17999999999999,91.82,102.375]}