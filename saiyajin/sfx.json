24,"eye_open",0.9],[76.44,"shimmer",0.7],[77.74,"whoosh_soft",0.5],[77.79,"babble",0.9],[77.79,"pop",0.45],[77.82,"flash",0.85],[78.02,"M_truth",1],[78.52,"swish",0.8],[78.57,"ripple",0.5],[80.51,"swish",0.8],[80.56,"ripple",0.5],[81.35,"swish",0.8],[81.4,"ripple",0.5],[81.9,"swish",0.8],[81.95,"ripple",0.5],[83.078,"swish",0.8],[83.128,"ripple",0.5],[83.57,"dark",0.85],[83.68,"shimmer",0.5],[83.73,"babble",0.9],[83.73,"pop",0.45],[83.87,"wind",0.9],[87.9,"swish",0.5],[87.95,"babble",0.9],[87.95,"pop",0.45],[87.98,"whoosh",0.85],[88.18,"M_rise",1],[91.338,"impact",1],[91.388,"boom",0.6],[91.58,"energy_pulse",0.5],[91.63,"babble",0.9],[91.63,"pop",0.45],[91.82,"wind",0.8],[95.236,"breath",0.6],[97.76,"riser_s",0.9],[98.36,"M_hero",1],[98.36,"boom",1.3],[98.36,"energy",1],[98.36,"shimmer",0.8],[99.33,"final",0.9]],"total":102.375,"phrases":[["E se você fosse um Saiyajin…",0,1.92],["e cada derrota te deixasse mais forte que antes?",1.92,5.42],["Você nasceria em uma das raças guerreiras mais temidas do universo.",6.06,10.12],["Desde pequeno, seria treinado para enfrentar inimigos capazes de destruir planetas inteiros.",10.6,16.36],["Mas seu maior diferencial seria assustador…",16.76,20.3],["Quando sobrevivesse a uma batalha extrema e se recuperasse,",20.9,24.12],["seu corpo poderia aumentar drasticamente o próprio poder.",24.5,27.9],["Isso significa que, quanto mais difícil fosse sua jornada…",27.9,31.88],["maior seria seu potencial de evolução.",32.24,34.62],["Mas tudo mudaria no dia em que enfrentasse um inimigo impossível de derrotar.",35.06,40.02],["Seus amigos estariam em perigo…",40.46,42.24],["E, pela primeira vez, você sentiria uma raiva tão intensa",42.46,46.4],["que seu corpo começaria a liberar uma energia jamais vista.",46.4,50.12],["Seu cabelo ficaria dourado.",50.64,52.34],["Seus olhos mudariam.",52.7,54.02],["E uma aura gigantesca explodiria ao seu redor.",54.02,57.62],["Você teria despertado o lendário Super Saiyajin.",57.62,61.68],["Só que essa transformação seria apenas o começo.",61.88,65.04],["Com treinamento e batalhas cada vez mais difíceis,",65.46,68.68],["você alcançaria poderes capazes de rivalizar com os próprios deuses.",68.86,72.92],["E, no auge da sua evolução, despertaria o Instinto Superior…",73.44,77.76],["Uma habilidade em que seu corpo reagiria sozinho, desviando de ataques quase impossíveis.",78.22,83.7],["Mas existe uma verdade que poucos entendem sobre os Saiyajins…",84.12,87.92],["Eles não são extraordinários porque nunca são derrotados.",88.38,91.6],["Eles são extraordinários porque, mesmo depois de cair,",92.02,95.34],["sempre encontram uma maneira de se tornar mais fortes.",95.68,98.98]],"cuts":[0,5.859999999999999,10.4,13.120000000000001,16.51,20.7,27.7,34.81,40.26,42.31,50.39,52.550000000000004,53.82,57.419999999999995,61.68,65.30999999999999,68.71,73.19,78.02,83.87,88.17999999999999,91.82]}