],[56.752,"eye_open",0.9],[56.952,"shimmer",0.7],[57.788,"swish",0.5],[57.838,"babble",0.9],[57.838,"pop",0.45],[57.858,"flash",0.85],[58.058,"M_truth",1],[58.558,"swish",0.8],[58.608,"ripple",0.5],[60.122,"swish",0.8],[60.172,"ripple",0.5],[60.504,"swish",0.8],[60.554,"ripple",0.5],[61.054,"swish",0.8],[61.104,"ripple",0.5],[61.944,"swish",0.8],[61.994,"ripple",0.5],[62.324,"energy_pulse",0.5],[62.374,"babble",0.9],[62.374,"pop",0.45],[62.394,"dark",0.85],[62.694,"wind",0.9],[65.624,"whoosh_soft",0.5],[65.674,"babble",0.9],[65.674,"pop",0.45],[65.794,"whoosh",0.85],[65.994,"M_rise",1],[68.585,"impact",1],[68.635,"boom",0.6],[68.716,"shimmer",0.5],[68.766,"babble",0.9],[68.766,"pop",0.45],[68.986,"wind",0.8],[71.892,"breath",0.6],[73.591,"riser_s",0.9],[74.191,"M_hero",1],[74.191,"boom",1.3],[74.191,"energy",1],[74.191,"shimmer",0.8],[74.852,"final",0.9]],"total":77.91666666666667,"phrases":[["E se você fosse um Saiyajin…",0.35,1.501],["e cada derrota te deixasse mais forte que antes?",1.851,3.975],["Você nasceria em uma das raças guerreiras mais temidas do universo.",4.525,7.503],["Desde pequeno, seria treinado para enfrentar inimigos capazes de destruir planetas inteiros.",7.953,12.216],["Mas seu maior diferencial seria assustador…",12.716,14.905],["Quando sobrevivesse a uma batalha extrema e se recuperasse,",15.455,18.151],["seu corpo poderia aumentar drasticamente o próprio poder.",18.351,21.138],["Ou seja, quanto mais difícil fosse sua jornada…",21.588,23.831],["maior seria seu potencial de evolução.",24.131,25.849],["Mas tudo mudaria no dia em que enfrentasse um inimigo impossível de derrotar.",26.449,29.682],["Seus amigos estariam em perigo…",30.182,31.436],["E, pela primeira vez, você sentiria uma raiva tão intensa",31.936,34.729],["que seu corpo começaria a liberar uma energia jamais vista.",34.879,37.481],["Seu cabelo ficaria dourado.",38.031,39.296],["Seus olhos mudariam.",39.696,40.488],["E uma aura gigantesca explodiria ao seu redor.",40.888,42.834],["Você teria despertado o lendário Super Saiyajin.",43.334,45.553],["Só que essa transformação seria apenas o começo.",46.153,48.278],["Com treinamento e batalhas cada vez mais difíceis,",48.728,51.047],["você alcançaria poderes capazes de rivalizar com os próprios deuses.",51.197,54.453],["E, no auge da sua evolução, despertaria o Instinto Superior…",54.953,57.808],["Uma habilidade em que seu corpo reagiria sozinho, desviando de ataques quase impossíveis.",58.258,62.344],["Mas existe uma verdade que poucos entendem sobre os Saiyajins…",62.944,65.644],["Eles não são extraordinários porque nunca são derrotados.",66.194,68.736],["Eles são extraordinários porque, mesmo depois de cair,",69.186,71.903],["sempre encontram uma maneira de se tornar mais fortes.",72.103,74.502]],"cuts":[0,4.325,7.753,9.93816304347826,12.466,15.255,21.388,26.199,29.982,31.786,37.781,39.546,40.687999999999995,43.134,45.952999999999996,48.578,51.047000000000004,54.703,58.058,62.694,65.994,68.986]}